// Shared target settings. Environment files (Develop/Release) include this one.

PRODUCT_NAME = Cengelish
PRODUCT_BUNDLE_IDENTIFIER = com.hasangurbuz.cengelish
INFOPLIST_FILE = Cengelish/Config/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Çengelish
DEVELOPMENT_LANGUAGE = tr
INFOPLIST_KEY_CFBundleDevelopmentRegion = tr
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Cengelish/Config/Cengelish.entitlements

// iCloud yedekleme (CloudKit). Entitlement ve Apple Developer'daki kapsayıcı hazırsa YES.
CENGELISH_CLOUDKIT = YES
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Deep-link scheme: cengelish://<DeepLinkPath>
APP_URL_SCHEME = cengelish
